# PostgreSQL
POSTGRES_DB=tasktracker
POSTGRES_USER=tasktracker
POSTGRES_PASSWORD=

# Authentication / security
# Use a strong random value.
TOKEN_SECURITY_KEY=

# Must be at least 32 characters.
PASSWORD_RECOVERY_HMAC_SECRET=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# Public URL of the frontend in the local Docker stack.
CLIENT_APP_BASE_URL=http://localhost:8080

# ClamAV file scanning (fail-closed by default until explicitly enabled)
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_HOST_PORT=3310
CLAMAV_CONNECT_TIMEOUT_MS=3000
CLAMAV_SCAN_TIMEOUT_MS=15000
CLAMAV_MAX_CONCURRENT_SCANS=4
TASKFILES_ENABLE_DISCUSSION_UPLOADS=false
TASKFILES_ENABLE_SUBTASK_SUBMISSION_UPLOADS=false
