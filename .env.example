# PostgreSQL
POSTGRES_DB=tasktracker
POSTGRES_USER=tasktracker
POSTGRES_PASSWORD=

# Authentication / security
# Use a strong random value.
TOKEN_SECURITY_KEY=

# Must be at least 32 characters.
PASSWORD_RECOVERY_HMAC_SECRET=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# Public URL of the frontend in the local Docker stack.
CLIENT_APP_BASE_URL=http://localhost:8080
