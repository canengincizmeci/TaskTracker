# Nonsecret production settings. Keep credential contents in the mounted files.
TASKTRACKER_HOSTNAME=tasks.example.invalid
TASKTRACKER_EDGE_PORT=8080
TASKTRACKER_EDGE_SUBNET=172.30.40.0/28
TASKTRACKER_CLIENT_PROXY_IP=172.30.40.3
POSTGRES_DB=tasktracker
POSTGRES_ADMIN_USER=postgres
TASKTRACKER_DB_ADMIN_PASSWORD_FILE=/etc/tasktracker/postgres-bootstrap-password
TASKTRACKER_API_SECRETS_DIR=/etc/tasktracker/api-secrets
TASKTRACKER_MIGRATION_SECRETS_DIR=/etc/tasktracker/migration-secrets
TASKTRACKER_PROXY_TRUST_DIR=/etc/tasktracker/proxy-trust
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_FROM_EMAIL=tasktracker@example.invalid
TASKFILES_ENABLE_DISCUSSION_UPLOADS=false
TASKFILES_ENABLE_SUBTASK_SUBMISSION_UPLOADS=false
