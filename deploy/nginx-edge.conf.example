# Install as a host Nginx HTTP-context include after replacing all uppercase placeholders.
# The certificate paths must already exist and match the verified hostname.
map $http_upgrade $tasktracker_edge_connection {
    default upgrade;
    '' close;
}

log_format tasktracker_edge escape=json
    '{"method":"$request_method","path":"$uri","status":$status,"seconds":$request_time}';

server {
    listen 80;
    server_name TASKTRACKER_HOSTNAME;
    access_log /var/log/nginx/tasktracker-access.log tasktracker_edge;
    error_log /dev/null;

    location ^~ /hubs/ { return 400; }
    location / { return 308 https://TASKTRACKER_HOSTNAME$request_uri; }
}

server {
    listen 443 ssl;
    server_name TASKTRACKER_HOSTNAME;
    ssl_certificate /REPLACE_WITH/CERTIFICATE_CHAIN.pem;
    ssl_certificate_key /REPLACE_WITH/PRIVATE_KEY.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/tasktracker-access.log tasktracker_edge;
    error_log /dev/null;

    client_max_body_size 101m;
    add_header Strict-Transport-Security "max-age=86400" always;

    location = /_health { return 404; }
    location / {
        proxy_pass http://127.0.0.1:TASKTRACKER_EDGE_PORT;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $tasktracker_edge_connection;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 120s;
    }
}
