{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "PostgreSql": ""
  },

  "Smtp": {
    "Host": "",
    "Port": 587,
    "User": "",
    "Pass": "",
    "FromEmail": ""
  },
  "TokenOptions": {
    "Audience": "tasktracker-client",
    "Issuer": "tasktracker-api",
    "AccessTokenExpiration": 30,
    "RefreshTokenExpirationDays": 7,
    "SecurityKey": ""
  },
  "TaskFiles": {
    "RootPath": "App_Data/task-files",
    "MaxFileSizeBytes": 20971520,
    "RequireCleanScan": true,
    "EnableDiscussionUploads": false,
    "EnableSubTaskSubmissionUploads": false,
    "MaxDiscussionAttachments": 5,
    "MaxDiscussionUploadBytes": 41943040,
    "Scanner": {
      "Enabled": false,
      "Host": "",
      "Port": 3310,
      "ConnectTimeoutMs": 3000,
      "ScanTimeoutMs": 15000,
      "MaxConcurrentScans": 4,
      "ChunkSizeBytes": 65536
    }
  }

}
