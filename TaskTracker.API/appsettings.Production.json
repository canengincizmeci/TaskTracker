{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ClientApp": {
    "BaseUrl": "https://canncodehub.com"
  },
  "TaskFiles": {
    "RequireCleanScan": true,
    "EnableDiscussionUploads": false,
    "EnableSubTaskSubmissionUploads": false,
    "Scanner": {
      "Enabled": false,
      "Host": "",
      "Port": 3310,
      "ConnectTimeoutMs": 3000,
      "ScanTimeoutMs": 15000,
      "MaxConcurrentScans": 4,
      "ChunkSizeBytes": 65536
    }
  }
}
